      "source": [
        "## Task: Given two matrices A and B (of same dimensions), find C = 2A - 3B"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Method 1"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 21,
      "metadata": {},
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "[[3, 2], [-1, -2]]\n"
          ]
        }
      ],
      "source": [
        "a = [[3, 4],\n",
        "     [7, 8]]\n",
        "b = [[1, 2],\n",
        "     [5, 6]]\n",
        "\n",
        "c = []\n",
        "x=2\n",
        "y=3\n",
        "for i,j in zip(a,b):\n",
        "    m=[]\n",
        "    for k,l in zip(i,j):\n",
        "        m.append(k*x-l*y)\n",
        "    c.append(m)\n",
        "print(c)\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Method 2"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 22,
      "metadata": {},
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "[[3, 2], [-1, -2]]\n"
          ]
        }
      ],
      "source": [
        "d=[]\n",
        "for i in range(len(a)):\n",
        "    m=[]\n",
        "    for j in range(len(a[i])):\n",
        "        m.append(x*a[i][j]-y*b[i][j])\n",
        "    d.append(m)\n",
        "print(d)"
      ]
    },
